# -----------------------------------------------------------------------------
# Environment variables reference for Mobile Pishro
#
# Current phase (frontend / UI, mock data): NO environment variables are
# required. The app runs out of the box with `npm install && npm run dev`.
#
# The variables below are placeholders for the next build phases (database,
# authentication, and real payment gateway integration). Copy this file to
# `.env.local` and fill in real values only when those phases are wired up.
# -----------------------------------------------------------------------------

# --- Database (Phase 2 — Prisma / PostgreSQL) ---
# DATABASE_URL="postgresql://user:password@localhost:5432/mobile_pishro"

# --- Auth (Phase 2 — NextAuth.js) ---
# NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_URL="http://localhost:3000"

# --- Payment gateways (Phase 3) ---
# ZARINPAL_MERCHANT_ID=""
# ZIBAL_MERCHANT_KEY=""

# --- SMS / OTP provider (Phase 3) ---
# SMS_API_KEY=""

# --- Public site URL (used for absolute URLs, sitemap, metadata) ---
# NEXT_PUBLIC_SITE_URL="https://mobilepishro.ir"
